# ─────────────────────────────────────────────────────────────
# AutoAttend AI v2.0 — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/autoattend_v2
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/autoattend_v2

# JWT Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Argon2 password hashing (secure defaults — change only if needed)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# TOTP (for teacher/hod/principal login only)
TOTP_ISSUER=AutoAttend AI

# Azure Face API
AZURE_FACE_ENDPOINT=https://centralindia.api.cognitive.microsoft.com/
AZURE_FACE_KEY=YOUR_AZURE_KEY_1_HERE
AZURE_PERSON_GROUP_ID=autoattend_college

# MSG91 (ONLY for password change OTP)
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY_HERE
MSG91_SENDER_ID=ATTEND
MSG91_OTP_TEMPLATE_ID=YOUR_TEMPLATE_ID_HERE
MSG91_EMAIL_TEMPLATE_ID=autoattend_email_otp
MSG91_EMAIL_FROM=noreply@autoattend.com
MSG91_EMAIL_DOMAIN=yourdomain.mailer91.com
# Transactional template emails (non-OTP). Leave blank to disable.
MSG91_WELCOME_TEMPLATE_ID=
MSG91_NOTIFICATION_TEMPLATE_ID=

# Twilio WhatsApp (parent alerts)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp parent/tutor alerts — MSG91 is PRIMARY, Twilio above is fallback.
# Fill these from your MSG91 WhatsApp dashboard (integrated number + approved
# template). Leave blank to use Twilio only, or leave both blank to disable
# WhatsApp (send_whatsapp_message() becomes a logged no-op).
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_TEMPLATE_NAME=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANG_CODE=en_US

# App Settings
APP_NAME=AutoAttend AI
DEBUG=False
FRONTEND_URL=http://localhost:3000
# Extra browser origins allowed by CORS beyond FRONTEND_URL (comma-separated).
# Useful for multiple college frontends. Leave empty to allow only FRONTEND_URL.
# Example: CORS_ALLOW_ORIGINS=https://a.example.edu,https://b.example.edu
CORS_ALLOW_ORIGINS=
COLLEGE_NAME=Your College Name

# Auth cookie (web). For cross-site (vercel ↔ render) use COOKIE_SAMESITE=none + COOKIE_SECURE=True.
# For local http dev set COOKIE_SECURE=False and COOKIE_SAMESITE=lax.
COOKIE_SECURE=True
COOKIE_SAMESITE=strict

# ── Field-level encryption (Fernet) — REQUIRED in production (DEBUG=False) ──
# Backend refuses to start if these are blank with DEBUG=False.
# Generate each with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate cadence: at least once a year, or immediately on compromise.
# Rotation procedure: see DEPLOYMENT_SECURITY.md.
TOTP_ENCRYPTION_KEY=
# Encrypts: qr_secret, bluetooth_token, push_token at rest.
SESSION_SECRET_ENCRYPTION_KEY=

# ── JWT signing (asymmetric, opt-in) ─────────────────────────────────
# Default ALGORITHM=HS256 uses SECRET_KEY. To use RS256/ES256/EdDSA set
# ALGORITHM and BOTH key paths below. See DEPLOYMENT_SECURITY.md.
# JWT_PRIVATE_KEY_PATH=/etc/secrets/jwt_priv.pem
# JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt_pub.pem

# Attendance Rules
ATTENDANCE_THRESHOLD=75.0
QR_EXPIRY_SECONDS=5
FACE_VERIFY_TOKEN_EXPIRY_SECONDS=60
GPS_RADIUS_METERS=50.0
GPS_ACCURACY_THRESHOLD_METERS=50.0
BLUETOOTH_REQUIRED=False

# AI Providers (ClassPulse + ClassPulse Live)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Claude (Anthropic) — PRIMARY AI provider (Gemini/Groq/DeepSeek are fallbacks).
# Haiku-only models (cost-optimised — never Opus/Sonnet). Leave blank to skip.
CLAUDE_API_KEY=
CLAUDE_MODEL_SMART=claude-haiku-4-5-20251001
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# ClassPulse Live
LIVE_SESSION_HEARTBEAT_INTERVAL=30
LIVE_SESSION_MIN_ATTENDANCE_MINUTES=30
LIVE_SESSION_LIVENESS_CHECK_INTERVAL=600
LIVE_SESSION_HOT_DOUBT_THRESHOLD=5
LIVE_SESSION_CONFUSION_THRESHOLD=3
LIVE_SESSION_AI_OBSERVATION_INTERVAL=120
LIVE_SESSION_ALLOW_GUEST_DEFAULT=false
LIVE_SESSION_MAX_GUESTS_DEFAULT=50

# Agora (optional — falls back to peer-to-peer WebRTC if blank)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Fast2SMS (Quick route SMS — leave blank to disable SMS in dev)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ── Sentry (error + performance monitoring) ─────────────────────────
# Leave SENTRY_DSN blank to disable Sentry entirely.
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
APP_ENV=production
APP_VERSION=2.0.0

# ── OpenTelemetry (DISABLED — set endpoint + install OTel libs to enable) ─
# To re-enable: uncomment the OTel block in backend/main.py and install
# `opentelemetry-sdk opentelemetry-exporter-otlp`.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Web Push (VAPID) — generate with: npx web-push generate-vapid-keys ──
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_SUBJECT=mailto:admin@traceln.app

# ── AWS S3 (leave-document uploads — issues #45 / #116) ──────────────
# Leave blank to disable S3 uploads. utils/s3_utils raises 503 when
# called without these. Region defaults to ap-south-1.
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=ap-south-1
