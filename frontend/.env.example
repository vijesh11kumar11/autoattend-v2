# AutoAttend AI — Web Frontend environment
#
# Leave VITE_API_BASE_URL empty (or delete it) when your frontend and
# backend share the same origin and a reverse proxy handles /api.
#
# Set it when they are on different domains, e.g.:
#   Frontend → Netlify / Vercel / Nginx static
#   Backend  → Render / Railway / your VPS
#
# VITE_API_BASE_URL=https://api.autoattend.example.com

# ── Sentry (error + performance monitoring) ─────────────────────────
# Leave VITE_SENTRY_DSN blank to disable Sentry in the browser.
VITE_SENTRY_DSN=https://your-frontend-sentry-dsn@sentry.io/project-id
VITE_APP_ENV=production

# ── Web Push (VAPID public key) — generate with: npx web-push generate-vapid-keys ──
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
